<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImlightDirectory Condition="'$(ImlightDirectory)' == ''">$(MSBuildThisFileDirectory)../.runtime/server</ImlightDirectory>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="WorldStateTests.cs" />
    <Compile Include="VendorTests.cs" />
    <Compile Include="ServiceRoutingTests.cs" />
    <Compile Include="SpellDropTests.cs" />
    <Compile Include="SpellRewardTests.cs" />
    <Compile Include="CombatAccuracyTests.cs" />
    <Compile Include="EquipmentItemCardTests.cs" />
    <Compile Include="InfiniteManaTests.cs" />
    <Compile Include="SpellNumberTests.cs" />
    <Compile Include="CreatureTurnTests.cs" />
    <Compile Include="TrainerTests.cs" />
    <Compile Include="QaGearTests.cs" />
    <Compile Include="NetworkTests.cs" />
    <Compile Include="../KiPacketBuffer.cs" Link="KiPacketBuffer.cs" />
    <Compile Include="../KiPacketCodec.cs" Link="KiPacketCodec.cs" />
    <Compile Include="../CombatAccuracy.cs" Link="CombatAccuracy.cs" />
    <Compile Include="../SpellRewards.cs" Link="SpellRewards.cs" />
    <Compile Include="../SpellDropRules.cs" Link="SpellDropRules.cs" />
    <Compile Include="../CreatureRandomization.cs" Link="CreatureRandomization.cs" />
    <ProjectReference Include="../server-build/Imlight.CoreLib.csproj" />
    <ProjectReference Include="../asset-tool/AssetTool.csproj" />
    <Reference Include="$(ImlightDirectory)/Imcodec.*.dll" />
    <Reference Include="$(ImlightDirectory)/Imlight.Common.dll" />
    <Reference Include="$(ImlightDirectory)/Akka.dll" />
    <Reference Include="$(ImlightDirectory)/Akka.Remote.dll" />
    <Reference Include="$(ImlightDirectory)/Raven.Client.dll" />
    <Reference Include="$(ImlightDirectory)/Raven.Embedded.dll" />
    <Reference Include="$(ImlightDirectory)/Newtonsoft.Json.dll" />
    <Reference Include="$(ImlightDirectory)/LiteDB.dll" />
    <Reference Include="$(ImlightDirectory)/Ionic.Zlib.Core.dll" />
    <Reference Include="$(ImlightDirectory)/BouncyCastle.Cryptography.dll" />
    <Reference Include="$(ImlightDirectory)/Serilog.dll" />
    <Reference Include="$(ImlightDirectory)/Sparrow.dll" />
    <Reference Include="$(ImlightDirectory)/Microsoft.Extensions.ObjectPool.dll" />
  </ItemGroup>
</Project>
